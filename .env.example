# PostgreSQL/PostGIS (copie para .env e personalize localmente)
POSTGRES_USER=geoia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geoia
POSTGRES_PORT=5432

# PostgreSQL/PostGIS isolado para testes espaciais (credenciais locais, nunca reutilize acima)
POSTGRES_TEST_USER=geoia_test
POSTGRES_TEST_PASSWORD=gere-uma-senha-local-unica
POSTGRES_TEST_DB=geoia_test
POSTGRES_TEST_PORT=5433

# Host usado pelo backend executado fora do Docker
DB_HOST=localhost

# JWT (gere uma chave aleatória com pelo menos 32 caracteres antes de iniciar a API)
JWT_SECRET_KEY=
JWT_ISSUER=geoia-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Geocodificação (buscas pontuais iniciadas pelo usuário; sem autocomplete)
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=GeoIA/0.1 (configure contato ou URL antes de publicar)
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_MIN_INTERVAL_SECONDS=1.1

# Busca pontual de estabelecimentos OSM/Overpass (instância pública, desenvolvimento)
PLACES_PROVIDER=overpass
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Prazo declarado à Overpass para executar a consulta (menor que o orçamento HTTP)
OVERPASS_QUERY_TIMEOUT_SECONDS=12
# Orçamento total da chamada ao provedor, incluindo tentativas limitadas
PLACES_TIMEOUT_SECONDS=20
PLACES_MIN_INTERVAL_SECONDS=2
PLACES_CACHE_TTL_SECONDS=60
